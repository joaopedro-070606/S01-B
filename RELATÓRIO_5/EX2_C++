#include <iostream>
using namespace std;

float calcular_confiabilidade_sistema(float probabilidades[], int tamanho) {
    float confiabilidade_total = 1.0;
    for(int i = 0; i < tamanho; i++) {
        confiabilidade_total = confiabilidade_total * probabilidades[i];
    }
    return confiabilidade_total;
}

int main() {
    int n;
    cout << "Digite a quantidade de componentes do sistema: ";
    cin >> n;
    
    float probabilidades[100]; 
    
    for(int i = 0; i < n; i++) {
        cout << "Digite a prrobabilidade do componente " << (i + 1) << " (ex: 0.95): ";
        cin >> probabilidades[i];
    }
    
    float total = calcular_confiabilidade_sistema(probabilidades, n);
    
    cout.setf(ios::fixed);
    cout.precision(4);
    cout << "\nConfiabilidade total do sistema: " << total << " (";
    
    cout.precision(2);
    cout << (total * 100) << "%)" << endl;
    
    return 0;
}