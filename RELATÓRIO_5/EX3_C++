#include <iostream>
using namespace std;

int main() {
    float capacidade_maxima;
    float peso_atual = 0.0;
    int opcao = 0;

    cout.setf(ios::fixed);
    cout.precision(2);

    cout << "Informe a capacidade maxima de carga do drone (kg): ";
    cin >> capacidade_maxima;

    while(opcao != 4) {
        cout << "\n=== SISTEMA DE CARGA DO DRONE ===" << endl;
        cout << "1. Verificar Carga" << endl;
        cout << "2. Carregar Pacote" << endl;
        cout << "3. Descarregar Pacote" << endl;
        cout << "4. Encerrar Operacao" << endl;
        cout << "Escolha uma opcao: ";
        cin >> opcao;

        if(opcao == 1) {
            cout << "\nCarga Atual: " << peso_atual << " kg / " << capacidade_maxima << " kg" << endl;
            cout << "Espaco Disponivel: " << (capacidade_maxima - peso_atual) << " kg" << endl;
        } 
        else if(opcao == 2) {
            float peso_pacote;
            cout << "\nDigite o peso do pacote a ser carregado (kg): ";
            cin >> peso_pacote;

            if((peso_atual + peso_pacote) > capacidade_maxima) {
                cout << "Alerta: Peso maximo de decolagem excedido! Operracao cancelada." << endl;
            } else {
                peso_atual = peso_atual + peso_pacote;
                cout << "Pacote adicionado com sucesso!" << endl;
            }
        } 
        else if(opcao == 3) {
            float peso_remover;
            cout << "\nDigite o peso do pacote a ser descarrregado (kg): ";
            cin >> peso_remover;

            if(peso_remover > peso_atual) {
                cout << "Erro: Nao e possivel remover um peso maior do que a carga atual." << endl;
            } else {
                peso_atual = peso_atual - peso_remover;
                cout << "Pacote descarregado com sucesso!" << endl;
            }
        } 
        else if(opcao == 4) {
            cout << "\nEncerrando sistena de telemetria..." << endl;
        } 
    }

    return 0;
}